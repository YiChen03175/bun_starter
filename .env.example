# Local Neon — set to use local Docker Postgres (see compose.yaml)
NEON_LOCAL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/main

# Cloud Neon — uncomment and set your cloud connection string
# DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App environment (development | production | test, defaults to "development")
# NODE_ENV=development

# Logging level (optional — e.g. debug, info, warn, error)
# LOG_LEVEL=info

# Site URL (optional — used for Better Auth trusted origins)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Skip env validation (e.g. for Docker builds without runtime vars)
# SKIP_ENV_VALIDATION=1
